## ===============================
## xSPRINT Backend .env.example (Railway / Local)
## ===============================

# Database Configuration (Neon / Railway Postgres)
DATABASE_URL=postgresql://user:password@host:5432/xsprint?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/xsprint?sslmode=require

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-64-character-hex-string
JWT_EXPIRES_IN=7d

# Admin Bootstrap (first admin creation)
ADMIN_BOOTSTRAP_CODE=change-this-to-a-secure-32-character-hex-code
ALLOW_MULTIPLE_ADMINS=false

# Security
BCRYPT_SALT_ROUNDS=10
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Server Configuration (Railway auto-injects PORT)
PORT=5000

# Optional: Gemini AI (if using AI features)
GEMINI_API_KEY=your-gemini-api-key-here

# Socket / Realtime (optional overrides)
SOCKET_PATH=/socket.io

# Observability
LOG_LEVEL=info
